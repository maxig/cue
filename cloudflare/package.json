{
  "name": "cue-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cue share stack on Cloudflare — Worker (API + web player) + D1 (metadata) + R2 (video) + Workers AI (Whisper transcription)",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "sync:app-resources": "esbuild src/index.js --bundle --format=esm --conditions=workerd,worker,browser --external:node:* --external:cloudflare:* --outfile=../Cue/Upload/CloudflareProvisioning/CueWorker.js && cp schema.sql ../Cue/Upload/CloudflareProvisioning/CueSchema.sql",
    "db:schema": "wrangler d1 execute cue --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute cue --local --file=./schema.sql",
    "db:migrate:metadata-sync": "wrangler d1 execute cue --remote --file=./migrations/0001_metadata_sync.sql",
    "db:migrate:upload-status": "wrangler d1 execute cue --remote --file=./migrations/0002_upload_status.sql"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^5.9.6"
  }
}
